# ==============================================================================
# CINEBOOK - CONFIGURAÇÃO APACHE / LITESPEED (HOSTINGER)
# URLs 100% Limpas e Profissionais (Sem .html e Sem index.html)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redireciona 'index.html' para a raiz limpa '/' (ex: /index.html -> /)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*index\.html\ HTTP/
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

  # 2. Redireciona qualquer página .html para a URL limpa (ex: /login.html -> /login, /cadastro.html -> /cadastro)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)\.html(\?|\ |\HTTP)
  RewriteRule ^(.*)\.html$ /$1 [R=301,L]

  # 3. Serve internamente o arquivo .html correspondente para URLs sem extensão
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# ==============================================================================
# COMPACTAÇÃO GZIP / BROTLI (CARREGAMENTO ULTRA RÁPIDO)
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ==============================================================================
# CACHE DO NAVEGADOR (DESEMPENHO MÁXIMO)
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ==============================================================================
# PWA - SERVICE WORKER, MANIFEST E ÍCONES
# ==============================================================================

# O service worker NUNCA pode ficar preso em cache: é ele quem controla a
# atualização de todo o resto. Sem isso, a regra de "1 mês" acima faria o
# navegador servir uma versão antiga do sw.js e o site nunca se atualizaria.
<FilesMatch "^(sw|service-worker)\.js$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </IfModule>
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
</FilesMatch>

# O manifest muda pouco, mas não deve ficar um mês parado.
<FilesMatch "manifest\.json$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</FilesMatch>

# Tipos MIME corretos (alguns servidores não conhecem .webmanifest)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .json
</IfModule>

# ==============================================================================
# PROTEÇÃO DE ARQUIVOS SENSÍVEIS
# ==============================================================================
# Sem isto, qualquer pessoa pode baixar o banco em
# https://seudominio.com.br/cinebook.db e ler e-mails e hashes de senha.
# O mesmo vale para os .py, que expõem a lógica do backend.
<FilesMatch "\.(db|sqlite|sqlite3|py|pyc|log|ini|env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Evita listagem direta de diretórios
Options -Indexes
